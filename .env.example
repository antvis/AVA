# Copy to `.env` and fill in your own key.
# Without OPENAI_API_KEY the LLM integration tests are skipped automatically.

OPENAI_API_KEY=sk-xxxxxxx
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com

# Tencent Docs SmartSheet (optional; never commit real credentials).
# SDK/CLI source configs use options.fileId and options.sheetId.
# The examples read native OpenAPI IDs from the environment.
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_OPEN_ID=
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_FILE_ID=
TENCENT_DOCS_SHEET_ID=

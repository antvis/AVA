        "name": "current_view",
        "statement": "SELECT * FROM (WITH RECURSIVE "sequence" (n) AS ((SELECT 1) UNION ALL (SELECT (n + 1) FROM "sequence" WHERE (n < 3))) SELECT n, 'AS ;' FROM "sequence" WHERE (n > 10)) AS "__ava_view"("empty, value", "label AS text")",

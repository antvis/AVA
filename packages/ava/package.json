{
  "name": "@antv/ava",
  "version": "4.0.0-alpha.1",
  "description": "A framework for AI-native Visual Analytics",
  "author": {
    "name": "AntV",
    "url": "https://antv.antgroup.com/"
  },
  "homepage": "https://ava.antv.antgroup.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/AVA/tree/ai/packages/ava"
  },
  "sideEffects": false,
  "keywords": [
    "visualization",
    "ai-native",
    "visual-analytics",
    "llm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "esm/index.js",
  "files": [
    "esm",
    "lib"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "lint": "eslint --ext .js,.jsx,.ts,.tsx './'",
    "lint-fix": "npm run lint -- --fix",
    "prettier": " prettier --check '**/*' --ignore-path=../../.prettierignore",
    "prettier-fix": "npm run prettier -- --write",
    "format": "npm run prettier-fix && npm run lint-fix",
    "lint-staged": "lint-staged",
    "clean": "rimraf lib esm",
    "build:cjs": "rimraf ./lib && tsc --module commonjs --outDir lib",
    "build:esm": "rimraf ./esm && tsc --module es6 --outDir esm",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^3.4.33",
    "better-sqlite3": "^11.8.1",
    "csv-parse": "^5.6.0",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^23.3.12",
    "@types/node": "^18.0.0",
    "eslint": "^7.32.0",
    "jest": "^24.9.0",
    "lint-staged": "^11.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.9.3"
  }
}

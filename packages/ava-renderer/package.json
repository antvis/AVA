{
  "name": "@antv/ava-renderer",
  "version": "0.0.1",
  "description": "A framework for automated visual analytics.",
  "author": {
    "name": "AntV",
    "url": "https://antv.antgroup.com/"
  },
  "homepage": "https://ava.antv.antgroup.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/AVA/tree/master/packages/ava"
  },
  "sideEffects": false,
  "keywords": [
    "visualization",
    "augmented-analytics",
    "insight"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "module": "src/index.ts",
  "files": [
    "esm",
    "dist",
    "lib"
  ],
  "scripts": {
    "lint": "eslint --ext .js,.jsx,.ts,.tsx './'",
    "lint-fix": "npm run lint -- --fix",
    "prettier": " prettier --check '**/*' --ignore-path=../../.prettierignore",
    "prettier-fix": "npm run prettier -- --write",
    "format": "npm run prettier-fix && npm run lint-fix",
    "lint-staged": "lint-staged",
    "clean": "rimraf lib esm dist",
    "build:umd": "father build",
    "build:cjs": "rimraf ./lib && tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "build:esm": "rimraf ./esm && tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@antv/g2": "^5.0.8",
    "@antv/gpt-vis": "^0.5.7",
    "@antv/g6": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@antv/ava": "^4.0.0-alpha.0"
  },
  "devDependencies": {
    "@antv/data-samples": "^1.0.1",
    "@antv/ava": "^4.0.0-alpha.0",
    "@stdlib/types": "^0.0.12",
    "@testing-library/jest-dom": "^4.2.4",
    "@types/d3-array": "^3.0.1",
    "@types/jest": "^23.3.12",
    "@types/lodash": "^4.14.171",
    "@types/numeral": "^2.0.2",
    "eslint": "^7.32.0",
    "father": "^4.1.0",
    "jest": "^24.9.0",
    "lint-staged": "^11.0.1",
    "npm-run-all": "^4.1.5",
    "numeral": "^2.0.6",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2",
    "ts-json-schema-generator": "^1.1.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^4.9.3"
  }
}

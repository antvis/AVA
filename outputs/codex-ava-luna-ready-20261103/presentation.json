              "text": "SELECT\n  strftime(CAST(completed_at AS DATE), '%Y-%m') AS month,\n  SUM(ROUND(CAST(line_paid_amount AS DECIMAL(18,2))*CAST(commission_rate AS DECIMAL(6,4)),2)-ROUND(COALESCE(CAST(refund_amount AS DECIMAL(18,2)),0)*CAST(commission_rate AS DECIMAL(6,4)),2)) AS net_sales,\n  COUNT(DISTINCT order_id) AS orders\nFROM data\nWHERE order_kind='customer_sale' AND status='completed'\n  AND CAST(completed_at AS DATE) >= DATE '2026-08-01'\n  AND CAST(completed_at AS DATE) < DATE '2026-10-01'\nGROUP BY 1 ORDER BY 1;"

{
  "name": "@antv/ava",
  "version": "4.0.0-alpha.1",
  "description": "A framework for AI-native Visual Analytics",
  "author": {
    "name": "AntV",
    "url": "https://antv.antgroup.com/"
  },
  "homepage": "https://ava.antv.vision/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antvis/AVA.git"
  },
  "sideEffects": false,
  "keywords": [
    "visualization",
    "ai-native",
    "visual-analytics",
    "llm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "esm/index.js",
  "files": [
    "esm",
    "lib"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "lint": "eslint --ext .ts,.tsx src __tests__",
    "lint-fix": "eslint --ext .ts,.tsx src __tests__ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" && npm run lint-fix",
    "clean": "rimraf lib esm",
    "build:cjs": "tsc --module commonjs --outDir lib",
    "build:esm": "tsc --module es2020 --outDir esm",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@duckdb/node-api": "^1.5.5-r.5",
    "ai": "^3.4.33",
    "csv-parse": "^5.6.0",
    "ssh2": "^1.17.0",
    "tslib": "^2.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^4.29.2",
    "@typescript-eslint/parser": "^4.29.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^2.4.0",
    "eslint-plugin-import": "^2.24.1",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}

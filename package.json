{
  "name": "ava",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint --ext .js,.jsx,.ts,.tsx \"./\"",
    "lint-fix": "npm run lint -- --fix",
    "prettier": "prettier -c \"**/*\"",
    "prettier:ava": "cd ./packages/ava && npm run prettier",
    "prettier-fix": "npm run prettier -- --write",
    "format": "npm run prettier-fix && npm run lint-fix",
    "format:ava": "cd ./packages/ava && npm run format",
    "test": "cd ./packages/ava && npm run test",
    "test:ava": "cd ./packages/ava && npm run test",
    "coverage": "cd ./packages/ava && npm run coverage",
    "coverage:ava": "cd ./packages/ava && npm run coverage",
    "build": "cd ./packages/ava && npm run build",
    "build:ava": "cd ./packages/ava && npm run build",
    "clean": "git clean -dfx"
  },

  "author": {
    "name": "AntV",
    "url": "https://antv.vision/"
  },
  "devDependencies": {
    "@types/jest": "^23.3.14",
    "@typescript-eslint/eslint-plugin": "^4.29.2",
    "@typescript-eslint/parser": "^4.29.2",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^2.4.0",
    "eslint-plugin-import": "^2.24.1",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2",
    "tslib": "^2.3.1",
    "typescript": "^4.9.3"
  }
}

# OpenAI-compatible Chat Completions provider (no Vercel account required).
# All three variables are required. No default model or API endpoint is used.
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Example OPENAI_BASE_URL: https://your-provider.example.com/v1
# Set this to your model's actual context window; default is 128000.
# MODEL_CONTEXT_WINDOW=128000
